{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Next.js Production Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "Stripe Webhook Listener",
      "runtimeExecutable": "stripe",
      "runtimeArgs": ["listen", "--forward-to", "localhost:3000/api/stripe/webhook"],
      "port": 3000
    }
  ]
}
